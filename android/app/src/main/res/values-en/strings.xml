    <string name="placeholder_phone">8613800138000</string>
    <string name="hint_phone">Required when the authentication method is "SMS code" (include the country code, for example 8613800138000).</string>
    <string name="hint_phone_zju">ZJU users normally do not need SMS authentication, leave it empty.</string>
    <string name="hint_other_auto">For non-ZJU users disableZJUConfig and skipDomainResource are applied automatically (only server-provided resource rules are used).</string>

