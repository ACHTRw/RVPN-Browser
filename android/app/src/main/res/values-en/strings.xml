    <!-- ==================== settings: mode ==================== -->
    <string name="options_title">RVPN login and connection</string>
    <string name="options_subtitle">The native rvpn-core program provides the RVPN connection; this app provides the UI and the browser proxy.</string>
    <string name="mode_heading">Mode</string>
    <string name="hint_mode_persist">The mode is remembered and restored after a restart; if RVPN cannot be established the app falls back to normal mode and explains why.</string>
    <string name="hint_mode_normal">Normal mode never touches the browser proxy, use it for everyday browsing.</string>
    <string name="hint_mode_rvpn">RVPN mode sends every tab through the local core; only matching resources go through RVPN, the rest connects directly.</string>

    <!-- ==================== settings: account ==================== -->
    <string name="section_account">Account</string>
    <string name="label_user_type">User type</string>
    <string name="user_type_zju">Zhejiang University user</string>
    <string name="user_type_other">Non-ZJU user</string>
    <string name="hint_user_type">ZJU users get built-in servers and rules; non-ZJU users must fill in the server, port, login domain and authentication method.</string>
    <string name="label_protocol">Protocol</string>
    <string name="protocol_atrust">aTrust (L3, recommended)</string>
    <string name="protocol_easyconnect">EasyConnect (L2, advanced)</string>
    <string name="hint_protocol_atrust">aTrust is the protocol used by the official client and supports L3 resources and the full set of authentication methods.</string>
    <string name="hint_protocol_easyconnect">EasyConnect is the older L2 protocol; use it only when aTrust is unavailable.</string>
    <string name="hint_protocol_atrust_zju">ZJU users use aTrust by default (vpn.zju.edu.cn).</string>
    <string name="hint_protocol_easyconnect_zju">For ZJU users EasyConnect connects to rvpn.zju.edu.cn.</string>
    <string name="label_server">Server</string>
    <string name="placeholder_server">vpn.zju.edu.cn</string>
    <string name="hint_server">Leave empty to use the built-in address for the selected user type (ZJU: vpn.zju.edu.cn / rvpn.zju.edu.cn).</string>
    <string name="label_port">Port</string>
    <string name="label_username">Username</string>
    <string name="placeholder_username">Student / staff ID</string>
    <string name="label_password">Password</string>
    <string name="label_save_password">Remember password</string>
    <string name="warn_password_plain">With "Remember password" enabled the password is stored in plain text in the private app storage (SharedPreferences) and is only readable by this app. Without it the password is kept in memory for the current run only.</string>
    <string name="hint_password_not_saved">"Remember password" is off, the password is kept in memory for this run only.</string>
    <string name="label_login_domain">Login domain</string>
    <string name="placeholder_login_domain">Radius</string>
    <string name="hint_login_domain_zju">ZJU users always use the Radius login domain, nothing to change here.</string>
    <string name="hint_login_domain_other">Non-ZJU users should use "Probe authentication methods" to discover the login domains of the server.</string>
    <string name="label_auth_type">Authentication</string>
    <string name="auth_type_auto">Automatic</string>
    <string name="auth_type_psw">Username and password (auth/psw)</string>
    <string name="auth_type_cas">CAS single sign-on (auth/cas)</string>
    <string name="auth_type_sms">SMS code (auth/smsCheckCode)</string>
    <string name="auth_type_oauth2">HTTPS OAuth2 (auth/httpsOauth2)</string>
    <string name="btn_probe_auth">Probe authentication methods</string>
    <string name="hint_probe">Probing calls the authInfo command of the core and lists the login domains and authentication methods the server supports. Tap one to fill it in.</string>
    <string name="probe_running">Probing…</string>
    <string name="probe_failed">Probe failed: %1$s</string>
    <string name="probe_empty">The server returned no usable authentication method</string>
    <string name="probe_applied">Filled in %1$s</string>
    <string name="probe_result_hint">Tap an entry to fill in the login domain and authentication method:</string>
