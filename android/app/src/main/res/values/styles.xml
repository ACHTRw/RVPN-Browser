<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ==================== theme ==================== -->
    <style name="Theme.RvpnBrowser" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorAccent">@color/brand_accent</item>
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/navigation_bar</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:colorBackground">@color/window_background</item>
        <item name="alertDialogTheme">@style/Theme.RvpnBrowser.Dialog</item>
    </style>

    <style name="Theme.RvpnBrowser.Dialog" parent="Theme.AppCompat.DayNight.Dialog.Alert">
        <item name="colorAccent">@color/brand_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:windowBackground">@color/card_background</item>
    </style>

    <!-- ==================== widgets ==================== -->
    <!-- Empty base style so that every "Widget.RvpnBrowser.*" style below has a
         resolvable implicit parent. The explicit empty parent stops aapt2 from
         looking for a style called "Widget". -->
    <style name="Widget.RvpnBrowser" parent="" />

    <style name="Widget.RvpnBrowser.ToolButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">@dimen/tool_button_size</item>
        <item name="android:layout_height">@dimen/tool_button_size</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/icon_tint</item>
    </style>

    <style name="Widget.RvpnBrowser.ToolButton.Small">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:padding">5dp</item>
    </style>

    <style name="Widget.RvpnBrowser.UrlBar" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/url_bar_height</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_url_bar</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:imeOptions">actionGo|flagNoExtractUi</item>
        <item name="android:inputType">textUri</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_normal</item>
        <item name="android:selectAllOnFocus">true</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Widget.RvpnBrowser.TabTitle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.RvpnBrowser.Card">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">@dimen/card_padding</item>
        <item name="android:layout_marginBottom">@dimen/space_medium</item>
    </style>

    <style name="Widget.RvpnBrowser.FieldLabel" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:paddingTop">@dimen/space_medium</item>
        <item name="android:paddingBottom">@dimen/space_tiny</item>
    </style>

    <style name="Widget.RvpnBrowser.Spinner" parent="Widget.AppCompat.Spinner.Underlined">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/field_height</item>
    </style>

    <style name="Widget.RvpnBrowser.Field" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/field_height</item>
        <item name="android:singleLine">true</item>
        <item name="android:textSize">@dimen/text_normal</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:inputType">text</item>
    </style>

    <style name="Widget.RvpnBrowser.Hint" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:paddingTop">@dimen/space_tiny</item>
    </style>

    <style name="Widget.RvpnBrowser.Hint.Warning">
        <item name="android:textColor">@color/warning_text</item>
        <item name="android:background">@drawable/bg_warning</item>
        <item name="android:padding">@dimen/space_medium</item>
        <item name="android:layout_marginTop">@dimen/space_small</item>
    </style>

    <style name="Widget.RvpnBrowser.SectionTitle" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_large</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.RvpnBrowser.CheckLine" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_normal</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:paddingTop">@dimen/space_small</item>
        <item name="android:paddingBottom">@dimen/space_small</item>
    </style>

    <style name="Widget.RvpnBrowser.Button" parent="Widget.AppCompat.Button.Borderless.Colored">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.RvpnBrowser.LogView" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/log_view_height</item>
        <item name="android:background">@drawable/bg_log</item>
        <item name="android:padding">@dimen/space_medium</item>
        <item name="android:textColor">@color/log_text</item>
        <item name="android:textSize">11sp</item>
        <item name="android:typeface">monospace</item>
        <item name="android:scrollbars">vertical</item>
    </style>

    <style name="Widget.RvpnBrowser.CoreKey" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">110dp</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:paddingTop">@dimen/space_tiny</item>
        <item name="android:paddingBottom">@dimen/space_tiny</item>
    </style>

    <style name="Widget.RvpnBrowser.CoreValue" parent="Widget.AppCompat.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:paddingTop">@dimen/space_tiny</item>
        <item name="android:paddingBottom">@dimen/space_tiny</item>
    </style>

</resources>
